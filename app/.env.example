# All optional.

# The Rigbrew server, used for sign-in, export and delete. Default: https://api.rigbrew.dev
VITE_RIGBREW_SERVER=

# Browser preview (pnpm dev, no Tauri window) normally finds the local service by itself
# (the dev server reads daemon.json). Set these only to point it at another service.
VITE_RIGBREW_PORT=
VITE_RIGBREW_TOKEN=
