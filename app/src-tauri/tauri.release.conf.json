{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "sh scripts/bundle-daemon.sh && pnpm build"
  },
  "bundle": {
    "externalBin": [
      "binaries/rigbrewd"
    ],
    "category": "Productivity",
    "shortDescription": "AI that runs on your own computer.",
    "copyright": "Rigbrew contributors, Apache-2.0",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
